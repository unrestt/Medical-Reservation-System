generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String   // Imię i nazwisko
  role      String   // "PATIENT", "DOCTOR", "ADMIN"
  createdAt DateTime @default(now())
  
  // Relacje
  doctorProfile DoctorProfile?
  appointmentsAsPatient Appointment[] @relation("PatientAppointments")
  appointmentsAsDoctor  Appointment[] @relation("DoctorAppointments")
}

model DoctorProfile {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  specialty      String
  city           String
  bio            String?  // Opis / bio lekarza
  profilePicture String?  // Link / URL do zdjęcia profilowego
  
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  availabilities Availability[]
}

model Availability {
  id          Int      @id @default(autoincrement())
  doctorId    Int
  dayOfWeek   Int      // 0 (Niedziela) - 6 (Sobota)
  startTime   String   // np. "08:00"
  endTime     String   // np. "16:00"
  
  doctorProfile DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

model Appointment {
  id          Int      @id @default(autoincrement())
  patientId   Int
  doctorId    Int
  dateTime    DateTime
  status      String   @default("CONFIRMED") // "CONFIRMED", "CANCELLED"
  description String   // Czego dotyczy wizyta
  
  patient     User     @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  doctor      User     @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Cascade)
}

